# Amlaki — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# === Lovable Cloud (Supabase) — auto-provisioned, read-only ===
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# === Error monitoring (optional, recommended for production) ===
# Get a DSN from https://sentry.io → Project → Settings → Client Keys
VITE_SENTRY_DSN=

# === Push notifications (Capacitor / FCM) — server-side only ===
# Service account JSON for Firebase Cloud Messaging (used by the
# `send-push` edge function). Stored as a runtime secret in Lovable
# Cloud — do NOT prefix with VITE_ and do NOT commit.
# FCM_SERVICE_ACCOUNT_JSON=

# === Feature flags (optional) ===
# VITE_FEATURE_DAILY_RENTALS=true
